{
  "name": "agentica-desktop",
  "version": "1.5.2",
  "private": true,
  "description": "Electron shell around the agentica gateway. Mechanism only: process lifecycle and one window.",
  "author": "XuMing <xuming624@qq.com>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/shibing624/agentica",
  "main": "main.js",
  "scripts": {
    "prestart": "node scripts/dev-bundle-name.js",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "prepare-runtime": "node scripts/prepare-runtime.js",
    "test": "node --test runtime.test.js"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "devDependencies": {
    "electron": "^43.4.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.github.shibing624.agentica",
    "productName": "Agentica",
    "copyright": "Copyright © 2026 XuMing",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "gateway.js",
      "runtime.js",
      "port-memory.js",
      "util.js",
      "window-state.js",
      "cli-shim.js",
      "updater.js",
      "package.json",
      "build/icon.png"
    ],
    "extraResources": [
      {
        "from": "runtime/${os}-${arch}",
        "to": "runtime"
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "shibing624",
        "repo": "agentica"
      }
    ],
    "npmRebuild": false,
    "artifactName": "agentica-desktop-${platform}-${arch}.${ext}",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "appImage": {
      "artifactName": "Agentica-${arch}.${ext}",
      "executableArgs": ["--no-sandbox"]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.developer-tools",
      "icon": "build/icon-mac.png",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "title": "Agentica ${version}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Development",
      "synopsis": "Local agent workbench: CLI, Web and Desktop over one ~/.agentica",
      "desktop": {
        "entry": {
          "Name": "Agentica",
          "Comment": "Local agent workbench"
        }
      }
    }
  }
}
