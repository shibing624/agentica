# Model provider (at least one). Copied to .env for docker compose.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: pin the gateway machine token (scripts / @agentica-ai/sdk).
# AGENTICA_GATEWAY_TOKEN=

# Optional IM tokens — ignored unless you rebuild with those extras installed.
# TELEGRAM_BOT_TOKEN=
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=

# Host directory mounted at /workspace inside the container (default: `.`).
# WORKSPACE=/path/to/your/repo
